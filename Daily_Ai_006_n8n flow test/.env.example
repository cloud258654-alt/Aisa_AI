# 請複製為 .env，禁止提交到 Git

# 使用至少 32 字元的隨機字串；建立後不要任意更換
N8N_ENCRYPTION_KEY=請改成至少32字元的隨機字串

# LINE Developers > Messaging API channel
LINE_CHANNEL_SECRET=請填入LINE_Channel_Secret
LINE_CHANNEL_ACCESS_TOKEN=請填入LINE_Channel_Access_Token

# BI-RMP 後端驗證用，必須和 Backend 使用的值一致
BI_RMP_INTERNAL_API_KEY=請填入BI_RMP內部API金鑰

# 情境 A：Backend 在 Windows 本機執行，例如 uvicorn 8000
BI_RMP_BACKEND_BASE_URL=http://host.docker.internal:8000

# 情境 B：Backend 也是同一個 docker-compose 的 service，名稱為 backend
# BI_RMP_BACKEND_BASE_URL=http://backend:8000
