rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function currentUserProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function hasActiveProfile() { return signedIn() && currentUserProfile().data.status == 'active'; }
    function hasRole(role) { return hasActiveProfile() && currentUserProfile().data.role == role; }
    function hasAnyRole(roles) { return hasActiveProfile() && currentUserProfile().data.role in roles; }
    function isAdmin() { return hasRole('admin'); }
    function isManager() { return hasRole('manager'); }
    function isFinance() { return hasRole('finance'); }
    function isStaff() { return hasRole('staff'); }
    function maySoftDelete() { return isAdmin() || isManager(); }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth.uid == uid && hasActiveProfile() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'uid']));
    }
    match /customers/{id} {
      allow read: if hasAnyRole(['admin', 'manager', 'finance', 'staff']);
      allow create: if hasAnyRole(['admin', 'manager', 'staff']);
      allow update: if hasAnyRole(['admin', 'manager', 'staff']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted_at']) || maySoftDelete());
      allow delete: if false;
    }
    match /containers/{id} {
      allow read: if hasAnyRole(['admin', 'manager', 'finance', 'staff']);
      allow create: if isAdmin() || isManager() || (isStaff() && request.resource.data.total_setup_cost == 0);
      allow update: if isAdmin() || isManager() || (isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['container_no', 'size_ft', 'container_type', 'location_zone', 'location_label', 'status', 'note', 'updated_at']));
      allow delete: if false;
    }
    match /rental_records/{id} { allow read: if hasAnyRole(['admin', 'manager', 'finance', 'staff']); allow create, update: if isAdmin() || isManager(); allow delete: if false; }
    match /customer_ledgers/{id} {
      allow read: if hasAnyRole(['admin', 'manager', 'finance', 'staff']);
      allow create: if hasAnyRole(['admin', 'manager', 'finance']);
      allow update: if hasAnyRole(['admin', 'manager', 'finance']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted_at']) || maySoftDelete());
      allow delete: if false;
    }
    match /management_ledgers/{id} {
      allow read: if hasAnyRole(['admin', 'manager', 'finance', 'staff']);
      allow create: if hasAnyRole(['admin', 'manager', 'finance']);
      allow update: if hasAnyRole(['admin', 'manager', 'finance']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted_at']) || maySoftDelete());
      allow delete: if false;
    }
  }
}
